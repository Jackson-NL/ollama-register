# cftempmail mailbox file, e.g. exports/cftempmail_current.json (not committed)
OLLAMA_MAILBOX=exports/cftempmail_current.json

# SMSBower config (never commit real key)
SMSBOWER_API_KEY=
SMSBOWER_BASE=https://smsbower.page/stubs/handler_api.php
