# SMSBower config (never commit real key)
SMSBOWER_API_KEY=
SMSBOWER_BASE=https://smsbower.page/stubs/handler_api.php
SMSBOWER_SERVICE=ot
SMSBOWER_COUNTRY=151
SMSBOWER_PROVIDER_IDS=3419
SMSBOWER_MAX_PRICE=0.015
SMSBOWER_DIAL_CODE=+56
# Optional: route SMSBower API requests through local proxy
# SMSBOWER_PROXY=http://127.0.0.1:7890
SMSBOWER_CANDIDATE_RETRIES=5

# CLI status server
CLI_STATUS_HOST=127.0.0.1
CLI_STATUS_PORT=8787

# Browser/run controls
KEEP_BROWSER_OPEN=0
CAMOUFOX_HEADLESS=0
MAX_TOTAL_MS=600000
HUMAN_WAIT_MS=600000
MAIL_WAIT_MS=300000
SMS_WAIT_MS=60000
MAIN_POLL_MS=1000
CHALLENGE_POLL_MS=1000
CHALLENGE_CAP_MS=180000
CHALLENGE_CLICK_AFTER_SEC=8
CHALLENGE_AFTER_SUBMIT_MS=1500
CHALLENGE_AFTER_CLICK_MS=1200
OS_CLICK_FALLBACK=0
INITIAL_SETTLE_MS=800
SIGNUP_SETTLE_MS=1000
PHONE_AFTER_SUBMIT_MS=2000
PHONE_SUBMIT_WAIT_MS=12000
MAIL_POLL_INITIAL_MS=1000
SMS_POLL_INITIAL_MS=2000
CODE_SUBMIT_POLL_MS=500
CODE_SUBMIT_WAIT_MS=10000
PHONE_RETRY=4
PHONE_RETRY_DELAY_MS=4000
WATCH_INTERVAL_MS=2000
RUNNER_STATUS_INTERVAL_MS=3000
AUTO_FULL_ATTEMPTS=1
AUTO_FULL_KEEP_BROWSER_OPEN=0
AUTO_FULL_TARGET_MODE=single
AUTO_FULL_TARGET_COUNT=1
AUTO_FULL_CONCURRENCY=1

# Optional: Camoufox browser proxy
# CAMOUFOX_PROXY=http://127.0.0.1:7890

# Optional: use the local Clash Verge Rev controller and mixed proxy port.
CLASH_ENABLED=0
# CLASH_CONTROLLER_URL=http://127.0.0.1:9090
# CLASH_PROXY_URL=http://127.0.0.1:7890
# CLASH_SECRET=
# Rotate mihomo/Clash SELECT node after each registration attempt when CLASH_ENABLED=1.
CLASH_ROTATE_AFTER_RUN=1
CLASH_ROTATE_GROUP=SELECT
CLASH_ROTATE_EXCLUDE=香港|Hong Kong|HK|🇭🇰

# Optional: recover API key for an existing account
OLLAMA_EMAIL=
OLLAMA_PASSWORD=
OLLAMA_KEY_NAME=
